# ─────────────────────────────────────────────
#  CS Team App — Environment Configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ─────────────────────────────────────────────

# Server
PORT=3010

# ── Google Gemini AI (Dashboard AI Analysis) ─
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Groq — AI ตัวหลักของระบบ (ตารางงานพนักงาน, AI Triage, Dashboard AI, KPI) ──
# Gemini เป็นตัวสำรองอัตโนมัติเมื่อ Groq ล่ม — เว้น GROQ_API_KEY ว่างไว้ = ใช้ Gemini อย่างเดียว
# ยกเว้น CS Assistant (/api/ai/chat) ที่ยังใช้ Gemini อย่างเดียวเพราะต้องใช้ function-calling
# สร้าง key ฟรีได้ที่ console.groq.com/keys
# ดูโมเดลที่ใช้ได้ในบัญชี: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── AI Triage Inbox (คัดกรองข้อความไลน์) ─────
# on = ให้ระบบคัดกรองข้อความใหม่อัตโนมัติทุก 15 นาที (สูงสุด 60 ข้อความ/รอบ)
# ค่าอื่น/เว้นว่าง = ปิด auto (กดปุ่ม "คัดกรองเดี๋ยวนี้" เอง)
TRIAGE_AUTO=off
# ความถี่การคัดกรองอัตโนมัติ (นาที) ค่าเริ่มต้น 15
TRIAGE_AUTO_MINUTES=15
# แจ้งเตือน LINE ticket ค้าง: on = ส่งอัตโนมัติทุกครั้งที่คัดกรอง (รอบเดียวกับ TRIAGE_AUTO_MINUTES)
# (ต้องตั้งกลุ่มปลายทางที่ติ๊ก event "triage_alert" ใน ตั้งค่า → LINE)
TRIAGE_ALERT=off

# ── Main Database (CS Team) ───────────────────
DB_SERVER=localhost
DB_NAME=cs_team
DB_USER=your_username
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ── External Database (LicenseDB / Calllog) ──
EXT_DB_SERVER=your_external_server_ip
EXT_DB_NAME=LicenseDB
EXT_DB_USER=your_ext_username
EXT_DB_PASSWORD=your_ext_password
EXT_DB_ENCRYPT=false
EXT_DB_TRUST_CERT=true

# ── INFO_BKK (same server as LicenseDB) ──────────────────
INFO_DB_NAME=INFO_BKK

# ── Repair Notifications (LINE Messaging API) ─
LINE_CHANNEL_TOKEN=your_channel_access_token_here
LINE_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Azure DevOps Integration ─────────────────
# สร้าง PAT ได้ที่ Azure DevOps → User Settings → Personal Access Tokens
# ต้องมี scope: Work Items (Read)
AZURE_DEVOPS_PAT=your_azure_devops_pat_here

# ── File Upload ───────────────────────────────
UPLOAD_DIR=./uploads

# ── Google Calendar (ตารางงานพนักงาน / AI daily summary) ──
# 1) console.cloud.google.com → Enable "Google Calendar API"
# 2) APIs & Services → Credentials → Create API key (restrict to Calendar API)
GCAL_API_KEY=your_google_calendar_api_key_here
GCAL_CALENDAR_ID=schedule.supinfo@gmail.com

# ── Auto daily employee-schedule LINE summary ──
# ผูกกลุ่มปลายทางที่หน้า ตั้งค่า → LINE (ติ๊ก event "ตารางงานพนักงาน")
EMPCAL_LINE_SCHEDULE=08:00

# ── Monitor Tag: AI แนะนำเคสที่ติด Tag ได้ (รายวัน) ──
# รันอัตโนมัติวันละครั้งตามเวลานี้ (off = กดปุ่ม "ให้ AI หาเคส" เอง) · ใช้รุ่นถูก แยกจาก GEMINI_MODEL
MONITOR_SUGGEST_AUTO=on
MONITOR_SUGGEST_TIME=00:00
MONITOR_SUGGEST_MODEL=gemini-flash-lite-latest
# AI ติด Tag ให้เลยเมื่อมั่นใจสูง / น่าจะใช่ — เหลือรอยืนยันเฉพาะที่ไม่แน่ใจ (off = ทุกเคสรอยืนยันใน "เคสแนะนำ")
MONITOR_SUGGEST_AUTO_ACCEPT=on
# หน้า Monitor Tag เริ่มจากวันของเคสแรกที่ติด Tag — ใส่ YYYY-MM-DD เพื่อบังคับวันเริ่มเอง
MONITOR_DATA_START=
# รหัสผ่านก่อนเปิดหน้า "เคสแนะนำ" (ว่าง = ไม่ต้องใส่รหัส) — ถ้ามี $ ให้ครอบด้วย ' ' เช่น MONITOR_SUGGEST_PASSWORD='abc$123'
MONITOR_SUGGEST_PASSWORD=

# ── ผลการติดตั้ง AI (Dashboard) ──
# ร้านที่ติดตั้ง = ร้านที่มีเคสคำเหล่านี้ (คั่นด้วย ,) ตั้งแต่วันที่ AI_INSTALL_SINCE
AI_INSTALL_KEYWORDS=ssh,dataslot,tunnel
AI_INSTALL_SINCE=2026-06-01
