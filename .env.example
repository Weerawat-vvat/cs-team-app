# ─────────────────────────────────────────────
#  CS Team App — Environment Configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ─────────────────────────────────────────────

# Server
PORT=3010

# ── Anthropic AI (Dashboard AI Analysis) ─────
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ── Main Database (CS Team) ───────────────────
DB_SERVER=localhost
DB_NAME=cs_team
DB_USER=your_username
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ── External Database (LicenseDB / Calllog) ──
EXT_DB_SERVER=your_external_server_ip
EXT_DB_NAME=LicenseDB
EXT_DB_USER=your_ext_username
EXT_DB_PASSWORD=your_ext_password
EXT_DB_ENCRYPT=false
EXT_DB_TRUST_CERT=true

# ── Repair Notifications ──────────────────────
LINE_NOTIFY_TOKEN=your_line_notify_token_here
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── File Upload ───────────────────────────────
UPLOAD_DIR=./uploads
