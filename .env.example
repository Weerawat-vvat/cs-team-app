# ─────────────────────────────────────────────
#  CS Team App — Environment Configuration
#  คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ─────────────────────────────────────────────

# Server
PORT=3010

# ── Google Gemini AI (Dashboard AI Analysis) ─
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── AI Triage Inbox (คัดกรองข้อความไลน์) ─────
# on = ให้ระบบคัดกรองข้อความใหม่อัตโนมัติทุก 15 นาที (สูงสุด 60 ข้อความ/รอบ)
# ค่าอื่น/เว้นว่าง = ปิด auto (กดปุ่ม "คัดกรองเดี๋ยวนี้" เอง)
TRIAGE_AUTO=off
# ความถี่การคัดกรองอัตโนมัติ (นาที) ค่าเริ่มต้น 15
TRIAGE_AUTO_MINUTES=15
# แจ้งเตือน LINE เมื่อมี ticket ค้าง ≥15 นาที: on = ส่งอัตโนมัติทุก TRIAGE_ALERT_MINUTES นาที
# (ต้องตั้งกลุ่มปลายทางที่ติ๊ก event "triage_alert" ใน ตั้งค่า → LINE)
TRIAGE_ALERT=off
TRIAGE_ALERT_MINUTES=15

# ── Main Database (CS Team) ───────────────────
DB_SERVER=localhost
DB_NAME=cs_team
DB_USER=your_username
DB_PASSWORD=your_password
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ── External Database (LicenseDB / Calllog) ──
EXT_DB_SERVER=your_external_server_ip
EXT_DB_NAME=LicenseDB
EXT_DB_USER=your_ext_username
EXT_DB_PASSWORD=your_ext_password
EXT_DB_ENCRYPT=false
EXT_DB_TRUST_CERT=true

# ── INFO_BKK (same server as LicenseDB) ──────────────────
INFO_DB_NAME=INFO_BKK

# ── Repair Notifications (LINE Messaging API) ─
LINE_CHANNEL_TOKEN=your_channel_access_token_here
LINE_GROUP_ID=Cxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Azure DevOps Integration ─────────────────
# สร้าง PAT ได้ที่ Azure DevOps → User Settings → Personal Access Tokens
# ต้องมี scope: Work Items (Read)
AZURE_DEVOPS_PAT=your_azure_devops_pat_here

# ── File Upload ───────────────────────────────
UPLOAD_DIR=./uploads

# ── Google Calendar (ตารางงานพนักงาน / AI daily summary) ──
# 1) console.cloud.google.com → Enable "Google Calendar API"
# 2) APIs & Services → Credentials → Create API key (restrict to Calendar API)
GCAL_API_KEY=your_google_calendar_api_key_here
GCAL_CALENDAR_ID=schedule.supinfo@gmail.com

# ── Auto daily employee-schedule LINE summary ──
# ผูกกลุ่มปลายทางที่หน้า ตั้งค่า → LINE (ติ๊ก event "ตารางงานพนักงาน")
EMPCAL_LINE_SCHEDULE=08:00
